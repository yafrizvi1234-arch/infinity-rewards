{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Private owner-only user profile, real statistics, and unlocked perks.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Unique lowercase username without @ prefix.",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "minLength": 1,
          "maxLength": 50
        },
        "bio": {
          "type": "string",
          "description": "Short user bio.",
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL (Firebase Storage URL or compressed fallback).",
          "maxLength": 140000
        },
        "activeAccent": {
          "type": "string",
          "description": "Active avatar frame accent color.",
          "enum": ["cyan", "purple", "blue"]
        },
        "totalPoints": {
          "type": "integer",
          "description": "Real earned points persisted in Firestore."
        },
        "totalVisits": {
          "type": "integer",
          "description": "Total completed visits count."
        },
        "successfulVisits": {
          "type": "integer",
          "description": "Verified successful visits count."
        },
        "visitedToday": {
          "type": "integer",
          "description": "Visits completed in active session/day."
        },
        "unlockedShopIds": {
          "type": "array",
          "description": "Bounded list of unlocked shop item IDs (max 20)."
        },
        "lastActivityId": {
          "type": "string",
          "description": "Most recent activity document ID linked atomically to stat increments.",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account workspace creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "uid",
        "username",
        "displayName",
        "bio",
        "photoURL",
        "activeAccent",
        "totalPoints",
        "totalVisits",
        "successfulVisits",
        "visitedToday",
        "unlockedShopIds",
        "createdAt",
        "updatedAt"
      ]
    },
